APP_DOMAIN=your-subdomain.duckdns.org
FRONTEND_ORIGINS=https://your-subdomain.duckdns.org
FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SCHEDULED_TRANSFER_POLL_SECONDS=15
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
BANK_STAFF_USERS='[{"username":"admin","password_hash":"replace-with-a-werkzeug-hash","role":"admin"}]'
