{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bluebank-api.onrender.com/api/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://bluebank-api.onrender.com/docs/:path*"
    },
    {
      "source": "/openapi.json",
      "destination": "https://bluebank-api.onrender.com/openapi.json"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
