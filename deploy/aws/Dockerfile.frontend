FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY vite-project/package.json vite-project/package-lock.json ./
RUN npm ci

COPY vite-project/ ./
RUN npm run build

FROM nginx:stable-alpine

COPY deploy/aws/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/aws/proxy_params /etc/nginx/proxy_params
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80
